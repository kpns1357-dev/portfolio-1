# CivicOS Production & Development Environment Variables
NODE_ENV=development
PORT=3000

# Authentication Secrets (Must be at least 32 characters long)
JWT_SECRET=your_32_char_minimum_access_token_secret_key_here_12345
JWT_REFRESH_SECRET=your_32_char_minimum_refresh_token_secret_key_here_67890

# CSRF / CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection
DATABASE_URL="file:./civicos.db"

# Optional Upstash Redis for Distributed Multi-Instance Rate Limiting
# (If not provided, CivicOS automatically uses high-performance in-memory sliding window rate limiting)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
